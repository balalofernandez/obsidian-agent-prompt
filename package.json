{
  "name": "obsidian-agent-prompt",
  "version": "0.2.0",
  "description": "Obsidian plugin: select text, press a hotkey, type a prompt and let a CLI coding agent (Claude Code) edit your vault in the background.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "e2e": "node test/e2e/run.mjs",
    "smoke": "esbuild test/e2e/smoke.ts --bundle --platform=node --outfile=test/e2e/.run/smoke.cjs --log-level=warning && node test/e2e/.run/smoke.cjs"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "claude",
    "agent"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^26.6.6",
    "builtin-modules": "^5.5.0",
    "esbuild": "^0.28.2",
    "obsidian": "^1.14.4",
    "playwright-core": "^1.65.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6"
  }
}